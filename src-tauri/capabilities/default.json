{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for MDViewer",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "MDViewer",
  "version": "1.0.3",
  "identifier": "com.mdviewer-mj",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MDViewer",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "shortDescription": "Markdown Document Viewer",
    "longDescription": "A powerful markdown document viewer with Mermaid support, syntax highlighting, and an elegant IntelliJ-inspired dark theme.",
    "category": "Productivity",
    "copyright": "© 2026 Lambda House"
  },
  "plugins": {}
}
